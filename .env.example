# Supabase Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets)
# Never commit real values.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Browser config (reverbly-supabase-config.js) — public values only:
# - stripeTrialLink: live Payment Link URL
# - stripePortalFunctionUrl: https://<project>.supabase.co/functions/v1/reverbly-stripe-portal
# - analyticsEndpoint: optional collector URL
